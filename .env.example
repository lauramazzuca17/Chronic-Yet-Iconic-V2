# Turso — production / Vercel (required there)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local next.dev / Playwright: if TURSO_* are unset, app uses a gitignored
# local file libSQL (see FEAT-009 / AGENTS.md). Unit tests use in-process DB.

# Session signing secret (generate a long random string)
SESSION_SECRET=

# Seed account passwords (hashes derived at runtime; never commit real values)
SEED_PASSWORD_LAURA=
SEED_PASSWORD_DEMO=
